{
    "name": "mj-zana/captcha",
    "description": "CAPTCHA providers for Zana applications: Cloudflare Turnstile, Google reCAPTCHA and hCaptcha behind #[VerifyHuman], chosen by configuration",
    "type": "library",
    "keywords": [
        "zana",
        "captcha",
        "turnstile",
        "recaptcha",
        "hcaptcha",
        "bot"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.21",
        "mj-zana/http": "^2.25",
        "mj-zana/security": "^2.25",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "mj-zana/routing": "^2.21",
        "mj-zana/view": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^8.1"
    },
    "suggest": {
        "mj-zana/view": "For the captcha_widget() helper",
        "symfony/http-client": "A PSR-18 client to ask the provider (Psr18Client), or any other PSR-18 client"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Captcha\\Tests\\": "tests/"
        }
    },
    "repositories": [
